NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only, nunca exponer al cliente. Dashboard -> Project Settings -> API -> secret key.
SUPABASE_SERVICE_ROLE_KEY=
# resend.com -> API Keys. Server-only.
RESEND_API_KEY=
# Opcional: dirección "From". Sin dominio propio verificado en Resend, dejar
# el sandbox por defecto (onboarding@resend.dev) o directamente omitir.
EMAIL_FROM=
# developer.paypal.com -> My Apps & Credentials. Server-only.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox mientras se prueba; en producción cambiar a https://api-m.paypal.com
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
